@page
@{
    ViewData["Title"] = "Vendor List";
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" v-text="state.mainTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" v-model="state.id" id="Id" name="Id" />
                    <form id="MainForm">
                        <div class="card mb-3">
                            <div class="card-header">
                                <h5>Main Info</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label for="VendorGroup">Vendor Group</label>
                                        <div ref="vendorGroupIdRef"></div>
                                        <label class="text-danger" v-text="state.errors.vendorGroupId"></label>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="Number">Number</label>
                                        <input ref="numberRef" v-model="state.number" class="form-control" readonly />
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label for="TRN">TRN</label>
                                        <input ref="trnRef" v-model="state.trn" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label for="Name">Vendor Name</label>
                                        <input ref="nameRef" v-model="state.name" class="form-control" />
                                        <label class="text-danger" v-text="state.errors.name"></label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card mb-3">
                            <div class="card-header">
                                <h5>Address</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-md-4">
                                        <label for="Country">Country</label>
                                        <div ref="countryRef"></div>
                                        <label class="text-danger" v-text="state.errors.countryId"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="Governorate">Governorate</label>
                                        <div ref="governorateRef"></div>
                                        <label class="text-danger" v-text="state.errors.governorateId"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="City">City</label>
                                        <div ref="cityRef"></div>
                                        <label class="text-danger" v-text="state.errors.cityId"></label>
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-md-3">
                                        <label for="BuildingNumber">Building Number</label>
                                        <input ref="buildingRef" v-model="state.buildingNumber" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label for="Floor">Floor</label>
                                        <input ref="floorRef" v-model="state.floor" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label for="FlatNumber">Flat</label>
                                        <input ref="flatRef" v-model="state.flatNumber" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label for="PostalCode">Postal Code</label>
                                        <input ref="postalRef" v-model="state.postalCode" class="form-control" />
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-md-8">
                                        <label for="Street">Street</label>
                                        <input ref="streetRef" v-model="state.street" class="form-control" />
                                    </div>
                                    <div class="col-md-4">
                                        <label for="Mobile">Mobile</label>
                                        <input ref="mobileRef" v-model="state.mobile" class="form-control" />
                                        <label class="text-danger" v-text="state.errors.mobile"></label>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button"
                            id="MainSaveButton"
                            class="btn btn-primary"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                        <span v-if="!state.isSubmitting">Save</span>
                        <span v-else>Saving...</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Vendors/VendorList.cshtml.js"></script>
}