@using Microsoft.Extensions.Localization
@using ASPNET.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var companyName = "companyName";
    var companyWeb = "companyWeb";
    var year = DateTime.Now.Year;
}
<footer class="main-footer">
    <div class="float-right d-none d-sm-block">
        <b>@Localizer["DevelopedBy"]:</b> <a href="https://store.indotalent.com">https://store.indotalent.com</a>
    </div>
    <small id="footerContent">
        &copy; @year <a href="@companyWeb">@companyName</a>, @Localizer["AllRightsReserved"].
    </small>
</footer>